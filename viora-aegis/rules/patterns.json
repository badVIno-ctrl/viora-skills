{
  "$schema": "viora-rules/1",
  "version": "1.0.0",
  "pack": "viora-aegis-core",
  "categories": {
    "INJ": "Injection (SQL/NoSQL/command/code/template/LDAP/XXE)",
    "XSS": "Cross-site scripting and unsafe rendering",
    "AUTH": "Authentication, session and access control",
    "CRYPTO": "Cryptography and transport security",
    "SECRET": "Hardcoded credentials and key material",
    "DEFAULT": "Insecure defaults, fail-open and debug surfaces",
    "SSRF": "Server-side request forgery and unsafe outbound calls",
    "PATH": "Path traversal, unsafe file and archive handling",
    "DESER": "Unsafe deserialization",
    "AI": "LLM and agent-specific risks",
    "SUPPLY": "Supply chain, CI/CD and build integrity",
    "CONTAINER": "Container and infrastructure configuration",
    "DOS": "Resource exhaustion and missing limits",
    "LOG": "Logging, error handling and data exposure"
  },
  "rules": [
    {
      "id": "INJ-001",
      "title": "SQL query built by string interpolation",
      "category": "INJ",
      "severity": "critical",
      "confidence": "high",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-89",
      "include": [
        "*.py",
        "*.rb",
        "*.php",
        "*.java",
        "*.kt",
        "*.cs",
        "*.go",
        "*.js",
        "*.ts",
        "*.jsx",
        "*.tsx",
        "*.scala",
        "*.rs"
      ],
      "pattern": "(?i)(select|insert into|update|delete from)\\s+[^;\"'`\\n]{0,120}(\\$\\{[^}]+\\}|%s['\"]?\\s*%|\\+\\s*[A-Za-z_$][\\w$.\\[\\]]*|f['\"][^'\"]*\\{|\\.format\\(|'\\s*\\.\\s*\\$)",
      "exclude_line": "(?i)(^\\s*(#|//|\\*|--)|:param|\\?\\s*,|prepare\\(|placeholder)",
      "fix": "Use parameter binding: cursor.execute(sql, params) / db.query(sql, [v]) / ORM. Never concatenate."
    },
    {
      "id": "INJ-002",
      "title": "Shell command executed with shell=True or interpolated string",
      "category": "INJ",
      "severity": "critical",
      "confidence": "high",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-78",
      "include": [
        "*.py",
        "*.rb",
        "*.php",
        "*.js",
        "*.ts",
        "*.java",
        "*.go",
        "*.cs",
        "*.sh"
      ],
      "pattern": "(subprocess\\.(run|call|Popen|check_output|check_call)\\([^)]*shell\\s*=\\s*True|os\\.(system|popen)\\(|child_process\\.(exec|execSync)\\(|Runtime\\.getRuntime\\(\\)\\.exec\\(|shell_exec\\(|passthru\\(|proc_open\\(|popen\\(|(?<![\\w.$])(exec|execSync|spawn|spawnSync)\\s*\\(\\s*[`'\\\"][^`'\\\"\\n]*(\\$\\{|['\\\"]\\s*\\+|`\\s*\\+)|exec\\.Command\\(\\\"(sh|bash|cmd|powershell)\\\"|system\\(\\s*[\\\"'][^\\\"'\\n]*\\\"\\s*\\.\\s*\\$)",
      "exclude_line": "^\\s*(#|//|\\*)",
      "fix": "Pass an argv array with shell=False / execFile / ProcessBuilder. Allowlist the binary and validate each argument."
    },
    {
      "id": "INJ-003",
      "title": "Dynamic code evaluation",
      "category": "INJ",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-95",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.jsx",
        "*.tsx",
        "*.rb",
        "*.php",
        "*.lua",
        "*.pl",
        "*.r",
        "*.ps1"
      ],
      "pattern": "(?<![\\w.$])eval\\s*\\(|new\\s+Function\\s*\\(|setTimeout\\s*\\(\\s*['\\\"]|setInterval\\s*\\(\\s*['\\\"]|Invoke-Expression|create_function\\(|vm\\.runInThisContext\\(",
      "exclude_line": "(?i)(^\\s*(#|//|\\*)|eval\\s*\\(\\s*['\"]?\\)|\\.eval\\(|noqa|viora-ignore)",
      "fix": "Replace with a parser, a lookup table or a JSON schema. If evaluation is unavoidable, sandbox it and allowlist the grammar."
    },
    {
      "id": "INJ-004",
      "title": "NoSQL operator injection ($where / JS evaluation in query)",
      "category": "INJ",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-943",
      "include": [
        "*.js",
        "*.ts",
        "*.py",
        "*.rb"
      ],
      "pattern": "(\\$where\\s*:|mapReduce\\(|\\$function\\s*:|\\$accumulator\\s*:)",
      "fix": "Never pass user input into $where/$function. Cast types explicitly and reject keys starting with '$'."
    },
    {
      "id": "INJ-005",
      "title": "Server-side template rendered from a user-controlled string",
      "category": "INJ",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-1336",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.rb",
        "*.php",
        "*.java"
      ],
      "pattern": "(render_template_string\\(|Template\\(\\s*(f['\"]|[A-Za-z_$][\\w$.]*\\s*\\)|.*\\+)|Twig.*createTemplate\\(|new\\s+SpelExpressionParser)",
      "fix": "Render fixed template files and pass user data as context variables only."
    },
    {
      "id": "INJ-006",
      "title": "XML parser without external-entity protection (XXE)",
      "category": "INJ",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-611",
      "include": [
        "*.py",
        "*.java",
        "*.cs",
        "*.php",
        "*.rb",
        "*.go"
      ],
      "pattern": "(xml\\.etree\\.ElementTree\\.(parse|fromstring)|xml\\.dom\\.minidom\\.parse|xml\\.sax\\.|DocumentBuilderFactory\\.newInstance\\(\\)|XmlTextReader\\(|simplexml_load_(string|file)\\(|libxml_disable_entity_loader\\(\\s*false)",
      "exclude_line": "(?i)(defusedxml|FEATURE_SECURE_PROCESSING|disallow-doctype-decl|XmlResolver\\s*=\\s*null)",
      "fix": "Use defusedxml (Python), disable DOCTYPE/external entities in the factory (Java), set XmlResolver = null (.NET)."
    },
    {
      "id": "INJ-007",
      "title": "Dynamic code execution via exec()/compile()",
      "category": "injection",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A05:2025",
      "cwe": "CWE-94",
      "include": [
        "*.py"
      ],
      "pattern": "(?<![\\w.])(exec|compile)\\s*\\(",
      "exclude_line": "(?i)(^\\s*(#|\\*)|re\\.compile|regex\\.compile|\\.compile\\(|noqa|viora-ignore)",
      "fix": "Replace with a parser, a lookup table or a JSON schema. If evaluation is truly required, run it in a sandboxed process with no filesystem, network or environment access."
    },
    {
      "id": "XSS-001",
      "title": "Raw HTML injection sink (innerHTML / document.write / outerHTML)",
      "category": "XSS",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-79",
      "include": [
        "*.js",
        "*.ts",
        "*.jsx",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.html"
      ],
      "pattern": "\\.(innerHTML|outerHTML)\\s*(\\+)?=\\s*(?!['\"`]\\s*['\"`])|document\\.write(ln)?\\s*\\(|insertAdjacentHTML\\s*\\(",
      "exclude_line": "(?i)(DOMPurify|sanitize|textContent|viora-ignore)",
      "fix": "Use textContent, or sanitize with DOMPurify before assignment. Prefer framework rendering."
    },
    {
      "id": "XSS-002",
      "title": "Framework escaping deliberately bypassed",
      "category": "XSS",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A05:2025 Injection",
      "cwe": "CWE-79",
      "include": [
        "*.jsx",
        "*.tsx",
        "*.js",
        "*.ts",
        "*.vue",
        "*.svelte",
        "*.html",
        "*.htm",
        "*.erb",
        "*.haml",
        "*.twig",
        "*.blade.php",
        "*.php",
        "*.cshtml",
        "*.j2",
        "*.jinja",
        "*.jinja2"
      ],
      "pattern": "(dangerouslySetInnerHTML|v-html\\s*=|@html\\s|\\|\\s*safe\\b|\\{\\{\\{|Html\\.Raw\\(|<%==|\\.html_safe\\b|raw\\(\\s*[A-Za-z_$@])",
      "exclude_line": "(?i)(DOMPurify|sanitize_html|bleach|viora-ignore)",
      "fix": "Remove the bypass, or sanitize with a vetted library (DOMPurify / bleach / sanitize-html) immediately before it."
    },
    {
      "id": "XSS-003",
      "title": "Unvalidated redirect from user input (open redirect)",
      "category": "XSS",
      "severity": "medium",
      "confidence": "medium",
      "owasp": "A01:2025 Broken Access Control",
      "cwe": "CWE-601",
      "include": [
        "*.js",
        "*.ts",
        "*.py",
        "*.rb",
        "*.php",
        "*.go",
        "*.java",
        "*.cs"
      ],
      "pattern": "(res\\.redirect\\(\\s*(req\\.|request\\.)|redirect\\(\\s*request\\.(GET|args|query|params)|http\\.Redirect\\([^,]+,[^,]+,\\s*r\\.(URL|FormValue)|sendRedirect\\(\\s*request\\.getParameter)",
      "fix": "Allowlist redirect targets or accept only relative paths validated against a known route table."
    },
    {
      "id": "AUTH-001",
      "title": "Fail-open authorization: security decision returns true on error",
      "category": "AUTH",
      "severity": "critical",
      "confidence": "medium",
      "owasp": "A01:2025 Broken Access Control",
      "cwe": "CWE-636",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.go",
        "*.java",
        "*.rb",
        "*.php",
        "*.cs"
      ],
      "pattern": "(?i)(catch[^\\n{]*\\{\\s*return\\s+true|except[^\\n:]*:\\s*return\\s+True|rescue[^\\n]*\\n?\\s*(return\\s+)?true|catch[^\\n{]*\\{\\s*(next\\(\\)|allow\\s*=\\s*true))",
      "fix": "Law 4: deny on error. Log the failure and return false / 403."
    },
    {
      "id": "AUTH-002",
      "title": "Authentication or CSRF protection disabled",
      "category": "AUTH",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A01:2025 Broken Access Control",
      "cwe": "CWE-352",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.rb",
        "*.php",
        "*.cs",
        "*.java",
        "*.yml",
        "*.yaml",
        "*.json"
      ],
      "pattern": "(?i)(csrf_exempt|@csrf\\.exempt|csrf\\s*:\\s*false|csrfProtection\\s*:\\s*false|skip_before_action\\s+:verify_authenticity_token|\\[AllowAnonymous\\]|WebSecurity[^\\n]*\\.ignoring\\(\\)|authentication\\s*[:=]\\s*(false|none|off)|auth\\s*[:=]\\s*false|permitAll\\(\\))",
      "fix": "Re-enable protection; if a route genuinely must be public, document why and confirm it exposes no state change."
    },
    {
      "id": "AUTH-003",
      "title": "Insecure session cookie flags",
      "category": "AUTH",
      "severity": "high",
      "confidence": "high",
      "owasp": "A07:2025 Authentication Failures",
      "cwe": "CWE-1004",
      "include": [
        "*.js",
        "*.ts",
        "*.py",
        "*.rb",
        "*.php",
        "*.go",
        "*.java",
        "*.cs"
      ],
      "pattern": "(?i)(httponly\\s*[:=]\\s*(false|0)|secure\\s*[:=]\\s*false\\s*[,}]|samesite\\s*[:=]\\s*['\"]?none['\"]?|SESSION_COOKIE_HTTPONLY\\s*=\\s*False|SESSION_COOKIE_SECURE\\s*=\\s*False)",
      "fix": "Session cookies must be httpOnly, secure and sameSite=lax|strict. SameSite=None requires Secure and a documented cross-site need."
    },
    {
      "id": "AUTH-004",
      "title": "JWT signature verification disabled or algorithm 'none'",
      "category": "AUTH",
      "severity": "critical",
      "confidence": "high",
      "owasp": "A07:2025 Authentication Failures",
      "cwe": "CWE-347",
      "include": [
        "*.js",
        "*.ts",
        "*.py",
        "*.go",
        "*.java",
        "*.rb",
        "*.php",
        "*.cs"
      ],
      "pattern": "(?i)(verify_signature\\s*[:=]\\s*(false|0)|jwt\\.decode\\([^)]*verify\\s*=\\s*False|jwt\\.verify\\([^)]*algorithms?\\s*:\\s*\\[?\\s*['\\\"]none['\\\"]|algorithms?\\s*[:=]\\s*\\[?\\s*['\\\"]none['\\\"]|jwt\\.decode\\((?![^)]*(key|secret|algorithms|options))[^)]*\\)|jwtDecode\\(|ValidateIssuerSigningKey\\s*=\\s*false|SignatureValidator\\s*=\\s*\\(\\))",
      "fix": "Always verify: pin the algorithm allowlist, supply the key, validate iss/aud/exp.",
      "exclude_line": "(?i)(viora-ignore|^\\s*(#|//|\\*))"
    },
    {
      "id": "AUTH-005",
      "title": "Password comparison is not constant-time",
      "category": "AUTH",
      "severity": "medium",
      "confidence": "medium",
      "owasp": "A07:2025 Authentication Failures",
      "cwe": "CWE-208",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.go",
        "*.rb",
        "*.php",
        "*.java"
      ],
      "pattern": "(?i)(password|token|secret|signature|hmac|api_?key)[\\w.\\[\\]']*\\s*(==|!=|===|!==)\\s*[\\w.\\[\\]'\"$]",
      "exclude_line": "(?i)(compare_digest|timingSafeEqual|secure_compare|hash\\.equals|is None|== None|!= None|=== undefined|!== undefined|== ''|== \\\"\\\"|viora-ignore)",
      "fix": "Use hmac.compare_digest / crypto.timingSafeEqual / MessageDigest.isEqual. For passwords, compare hashes via the KDF's verify()."
    },
    {
      "id": "CRYPTO-001",
      "title": "Weak hash used for a secret or password",
      "category": "CRYPTO",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A04:2025 Cryptographic Failures",
      "cwe": "CWE-916",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.php",
        "*.rb",
        "*.go",
        "*.java",
        "*.cs"
      ],
      "pattern": "(?i)(md5|sha1)\\s*\\(|createHash\\(\\s*['\"](md5|sha1)['\"]|hashlib\\.(md5|sha1)\\(|MessageDigest\\.getInstance\\(\\s*['\"](MD5|SHA-?1)|Digest::(MD5|SHA1)",
      "exclude_line": "(?i)(etag|checksum|cache|fingerprint|content_hash|dedup|non-security|viora-ignore)",
      "fix": "Passwords: Argon2id, bcrypt(cost>=12) or scrypt. Integrity: SHA-256+. MD5/SHA1 only for non-security checksums, and label it."
    },
    {
      "id": "CRYPTO-002",
      "title": "TLS certificate verification disabled",
      "category": "CRYPTO",
      "severity": "critical",
      "confidence": "high",
      "owasp": "A04:2025 Cryptographic Failures",
      "cwe": "CWE-295",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.go",
        "*.java",
        "*.rb",
        "*.php",
        "*.cs",
        "*.sh",
        "*.yml",
        "*.yaml",
        "Dockerfile*"
      ],
      "pattern": "(?i)(verify\\s*=\\s*False|InsecureSkipVerify\\s*:\\s*true|rejectUnauthorized\\s*:\\s*false|NODE_TLS_REJECT_UNAUTHORIZED\\s*=\\s*['\"]?0|CURLOPT_SSL_VERIFYPEER\\s*,\\s*(false|0)|curl\\s+[^\\n]*(-k|--insecure)\\b|ServicePointManager\\.ServerCertificateValidationCallback|ssl\\._create_unverified_context|OPENSSL_VERIFY_NONE|trustAllCerts)",
      "fix": "Never disable verification. For self-signed internal CAs, pin that CA bundle instead."
    },
    {
      "id": "CRYPTO-003",
      "title": "Weak or obsolete cipher / mode",
      "category": "CRYPTO",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A04:2025 Cryptographic Failures",
      "cwe": "CWE-327",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.java",
        "*.cs",
        "*.go",
        "*.php",
        "*.rb",
        "*.conf",
        "*.yml",
        "*.yaml"
      ],
      "pattern": "(?i)(\\b(DES|3DES|RC4|Blowfish)\\b|AES[-/_](ECB|CBC)(?![^\\n]*hmac)|MODE_ECB|['\"]aes-\\d+-ecb['\"]|SSLv2|SSLv3|TLSv1(\\.0|\\.1)?\\b|PKCS1v15)",
      "exclude_line": "(?i)(TLSv1\\.[23]|disable|forbid|reject|viora-ignore)",
      "fix": "Use AES-256-GCM or ChaCha20-Poly1305 with a random nonce, TLS 1.2+ only, OAEP/PSS for RSA."
    },
    {
      "id": "CRYPTO-004",
      "title": "Non-cryptographic randomness used for a security value",
      "category": "CRYPTO",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A04:2025 Cryptographic Failures",
      "cwe": "CWE-338",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.java",
        "*.go",
        "*.php",
        "*.rb",
        "*.cs"
      ],
      "pattern": "(?i)(Math\\.random\\(\\)|random\\.(random|randint|choice|randrange)\\(|new\\s+Random\\(|mt_rand\\(|rand\\(\\)|uniqid\\()",
      "exclude_line": "(?i)(test|mock|seed|jitter|sample|shuffle_display|animation|color|viora-ignore)",
      "fix": "Use secrets.token_urlsafe / crypto.randomBytes / SecureRandom / random_bytes for tokens, IDs, OTPs, salts and nonces."
    },
    {
      "id": "CRYPTO-005",
      "title": "Static or zero initialization vector / salt",
      "category": "CRYPTO",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A04:2025 Cryptographic Failures",
      "cwe": "CWE-329",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.java",
        "*.go",
        "*.cs",
        "*.php",
        "*.rb"
      ],
      "pattern": "(?i)(iv\\s*[:=]\\s*['\"][0-9a-fx\\\\ ]{4,}['\"]|iv\\s*[:=]\\s*(new\\s+byte\\[\\s*\\d+\\s*\\]|b?['\"]0{8,}|Buffer\\.alloc\\(\\s*\\d+\\s*\\))|salt\\s*[:=]\\s*['\"][^'\"]{2,}['\"])",
      "exclude_line": "(?i)(randomBytes|urandom|token_bytes|SecureRandom|gen_salt|viora-ignore)",
      "fix": "Generate a fresh random IV/nonce per message and a per-user random salt; store them alongside the ciphertext."
    },
    {
      "id": "DEFAULT-001",
      "title": "Fallback secret: application runs with a hardcoded default key",
      "category": "DEFAULT",
      "severity": "critical",
      "confidence": "high",
      "owasp": "A02:2025 Security Misconfiguration",
      "cwe": "CWE-1188",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.rb",
        "*.php",
        "*.go",
        "*.java",
        "*.cs"
      ],
      "pattern": "(?i)(os\\.(environ\\.get|getenv)\\(\\s*['\"][^'\"]*(secret|key|token|password|passwd|salt|pepper)[^'\"]*['\"]\\s*,\\s*['\"][^'\"]{4,}|process\\.env\\.[A-Z_]*(SECRET|KEY|TOKEN|PASSWORD|PASS)[A-Z_]*\\s*\\|\\|\\s*['\"][^'\"]{4,}|ENV\\.fetch\\(\\s*['\"][^'\"]*(SECRET|KEY|TOKEN|PASSWORD)[^'\"]*['\"]\\s*,\\s*['\"][^'\"]{4,}|getenv\\([^)]*\\)\\s*\\?\\?\\s*['\"][^'\"]{4,})",
      "fix": "Fail fast instead: read the variable and throw if missing. A default the app can boot with is a shipped credential."
    },
    {
      "id": "DEFAULT-002",
      "title": "Security control defaults to disabled",
      "category": "DEFAULT",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A02:2025 Security Misconfiguration",
      "cwe": "CWE-1188",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.rb",
        "*.php",
        "*.go",
        "*.java",
        "*.cs",
        "*.env*",
        "*.yml",
        "*.yaml"
      ],
      "pattern": "(?i)(get(env)?\\([^)]*(REQUIRE_AUTH|ENABLE_AUTH|AUTH_ENABLED|VERIFY|ENFORCE|STRICT|TLS|SSL|CSRF|RATE_LIMIT)[^)]*,\\s*['\"]?(false|0|off|no)['\"]?|process\\.env\\.[A-Z_]*(AUTH|VERIFY|ENFORCE|CSRF|TLS)[A-Z_]*\\s*\\|\\|\\s*['\"]?(false|0|off)['\"]?)",
      "fix": "Invert the default: unconfigured must mean enforced. Read the default value, not the flag name."
    },
    {
      "id": "DEFAULT-003",
      "title": "Debug mode or verbose errors enabled",
      "category": "DEFAULT",
      "severity": "medium",
      "confidence": "medium",
      "owasp": "A02:2025 Security Misconfiguration",
      "cwe": "CWE-489",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.rb",
        "*.php",
        "*.env*",
        "*.yml",
        "*.yaml",
        "*.json",
        "*.ini",
        "*.toml"
      ],
      "pattern": "(?i)(^|[^\\w.])(DEBUG|APP_DEBUG|FLASK_DEBUG|display_errors)\\s*[:=]\\s*(true|True|1|['\"]on['\"])|app\\.run\\([^)]*debug\\s*=\\s*True|\\.env\\.NODE_ENV\\s*!==?\\s*['\"]production['\"]\\s*\\?",
      "exclude_line": "(?i)(\\.example|template|test|spec|local\\.|development\\.|viora-ignore)",
      "fix": "Debug must be false unless explicitly enabled for local development. Never ship stack traces to users."
    },
    {
      "id": "DEFAULT-004",
      "title": "Permissive CORS (wildcard origin, or reflected origin with credentials)",
      "category": "DEFAULT",
      "severity": "high",
      "confidence": "medium",
      "owasp": "A02:2025 Security Misconfiguration",
      "cwe": "CWE-942",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.rb",
        "*.php",
        "*.go",
        "*.java",
        "*.cs",
        "*.yml",
        "*.yaml",
        "*.conf",
        "*.json"
      ],
      "pattern": "(?i)(Access-Control-Allow-Origin['\"]?\\s*[,:=]\\s*['\"]\\*|allow_origins\\s*=\\s*\\[\\s*['\"]\\*|origin\\s*:\\s*['\"]\\*['\"]|cors\\(\\s*\\)|origin\\s*:\\s*true|CORS_ORIGIN_ALLOW_ALL\\s*=\\s*True|AllowAnyOrigin\\(\\)|origin\\s*:\\s*(req|request)\\.headers)",
      "fix": "Allowlist exact origins from config. Wildcard + credentials is forbidden by the spec and by common sense."
    },
    {
      "id": "DEFAULT-005",
      "title": "Wildcard host / trust-all binding",
      "category": "DEFAULT",
      "severity": "medium",
      "confidence": "low",
      "owasp": "A02:2025 Security Misconfiguration",
      "cwe": "CWE-16",
      "include": [
        "*.py",
        "*.js",
        "*.ts",
        "*.yml",
        "*.yaml",
